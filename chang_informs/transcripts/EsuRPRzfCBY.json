[
  {
    "start": 0.0,
    "end": 1.8,
    "text": "善哥 我刚才全出了这一单"
  },
  {
    "start": 1.8,
    "end": 2.96,
    "text": "赚了二十多个点"
  },
  {
    "start": 2.96,
    "end": 3.96,
    "text": "但我现在不熟悉"
  },
  {
    "start": 3.96,
    "end": 4.56,
    "text": "我心里全是汉"
  },
  {
    "start": 4.56,
    "end": 5.84,
    "text": "心跳的跟打鼓一样"
  },
  {
    "start": 5.84,
    "end": 6.76,
    "text": "我真打不住了"
  },
  {
    "start": 6.76,
    "end": 8.52,
    "text": "二十个点落派为安"
  },
  {
    "start": 8.52,
    "end": 10.32,
    "text": "能保住本金和利润"
  },
  {
    "start": 10.32,
    "end": 11.52,
    "text": "没什么不好"
  },
  {
    "start": 11.52,
    "end": 12.48,
    "text": "可是我不明白"
  },
  {
    "start": 12.48,
    "end": 13.16,
    "text": "为什么"
  },
  {
    "start": 13.16,
    "end": 14.16,
    "text": "为什么亏二十点的时候"
  },
  {
    "start": 14.16,
    "end": 15.16,
    "text": "我能像个木头坐在里面"
  },
  {
    "start": 15.16,
    "end": 16.0,
    "text": "眼皮都不眨一下"
  },
  {
    "start": 16.0,
    "end": 16.6,
    "text": "越我越觉得"
  },
  {
    "start": 16.6,
    "end": 17.84,
    "text": "他会反弹丝丝捏着帽"
  },
  {
    "start": 17.84,
    "end": 19.04,
    "text": "反而现在赚了二十个点"
  },
  {
    "start": 19.04,
    "end": 19.56,
    "text": "稍微一会"
  },
  {
    "start": 19.56,
    "end": 20.4,
    "text": "我就吓得赶紧跑"
  },
  {
    "start": 20.4,
    "end": 21.48,
    "text": "我到底是怎么了"
  },
  {
    "start": 21.48,
    "end": 22.56,
    "text": "因为亏损的时候"
  },
  {
    "start": 22.56,
    "end": 24.32,
    "text": "你在和自己的执念死了"
  },
  {
    "start": 24.32,
    "end": 25.28,
    "text": "而盈利的时候"
  },
  {
    "start": 25.28,
    "end": 26.64,
    "text": "你在和贪婪死了"
  },
  {
    "start": 26.64,
    "end": 27.4,
    "text": "规规的影子"
  },
  {
    "start": 27.68,
    "end": 29.32,
    "text": "是你的认知在被市场牵着走"
  },
  {
    "start": 29.6,
    "end": 30.68,
    "text": "亏损二十个点时"
  },
  {
    "start": 30.88,
    "end": 31.96,
    "text": "想想你当时的心态"
  },
  {
    "start": 32.56,
    "end": 33.4,
    "text": "你买入的位置"
  },
  {
    "start": 33.56,
    "end": 34.56,
    "text": "正好采在了前期的"
  },
  {
    "start": 34.56,
    "end": 35.6,
    "text": "筹码密集套牢区"
  },
  {
    "start": 35.8,
    "end": 37.2,
    "text": "你的大脑在疯狂地给你洗脑"
  },
  {
    "start": 37.2,
    "end": 38.04,
    "text": "他用假象欺骗你"
  },
  {
    "start": 38.04,
    "end": 39.16,
    "text": "你在幻想这里支撑很强"
  },
  {
    "start": 39.16,
    "end": 40.16,
    "text": "逐利在大叔主席盘"
  },
  {
    "start": 40.16,
    "end": 41.08,
    "text": "你违背五日线策略"
  },
  {
    "start": 41.08,
    "end": 42.2,
    "text": "却把破卫下行的风险"
  },
  {
    "start": 42.2,
    "end": 43.32,
    "text": "幻想成暂时的回彩"
  },
  {
    "start": 43.32,
    "end": 44.16,
    "text": "你在等一个奇迹"
  },
  {
    "start": 44.16,
    "end": 45.36,
    "text": "那时候你不是在做交易"
  },
  {
    "start": 45.36,
    "end": 46.16,
    "text": "你是在赌气"
  },
  {
    "start": 46.16,
    "end": 47.6,
    "text": "在给自己的自尊心找台阶下"
  },
  {
    "start": 47.6,
    "end": 48.48,
    "text": "但盈利的时候不一样"
  },
  {
    "start": 48.48,
    "end": 49.72,
    "text": "那二十个点是真金白银"
  },
  {
    "start": 49.72,
    "end": 50.88,
    "text": "你的大脑又开始计算"
  },
  {
    "start": 50.88,
    "end": 52.48,
    "text": "这笔钱能换成现实中的什么利益"
  },
  {
    "start": 52.48,
    "end": 53.8,
    "text": "当你开始计算得失"
  },
  {
    "start": 53.8,
    "end": 54.96,
    "text": "你的心就已经乱了"
  },
  {
    "start": 54.96,
    "end": 55.92,
    "text": "你的时空量价系"
  },
  {
    "start": 55.92,
    "end": 57.2,
    "text": "立刻形同虚实"
  },
  {
    "start": 57.2,
    "end": 58.96,
    "text": "没有根本没有在执行系统"
  },
  {
    "start": 58.96,
    "end": 60.76,
    "text": "我是在为自己的情绪交易"
  },
  {
    "start": 60.76,
    "end": 62.68,
    "text": "《道德经》两千五百年前就说了"
  },
  {
    "start": 62.68,
    "end": 64.56,
    "text": "知人者智 自知者明"
  },
  {
    "start": 64.56,
    "end": 65.92,
    "text": "市场就是一面镜子"
  },
  {
    "start": 65.92,
    "end": 67.64,
    "text": "它照出的从来不是K线"
  },
  {
    "start": 67.64,
    "end": 68.52,
    "text": "而是你内心的"
  },
  {
    "start": 68.52,
    "end": 69.96,
    "text": "贪 称 吃 漫宜"
  },
  {
    "start": 69.96,
    "end": 70.72,
    "text": "亏损死昂"
  },
  {
    "start": 70.72,
    "end": 72.04,
    "text": "是你贪恋回本的幻想"
  },
  {
    "start": 72.04,
    "end": 72.64,
    "text": "盈利早跑"
  },
  {
    "start": 72.64,
    "end": 74.12,
    "text": "是你撑狠利润的局部回撤"
  },
  {
    "start": 74.12,
    "end": 75.2,
    "text": "认知决定一切"
  },
  {
    "start": 75.2,
    "end": 75.96,
    "text": "认知不够"
  },
  {
    "start": 75.96,
    "end": 77.0,
    "text": "财富即便到手"
  },
  {
    "start": 77.0,
    "end": 78.4,
    "text": "也拯救轮为过眼余焉"
  },
  {
    "start": 78.4,
    "end": 79.4,
    "text": "真正的交易员"
  },
  {
    "start": 79.4,
    "end": 81.0,
    "text": "从来不看具体的数字和服役"
  },
  {
    "start": 81.0,
    "end": 82.12,
    "text": "只看规则与系统"
  },
  {
    "start": 82.12,
    "end": 82.76,
    "text": "符合规则"
  },
  {
    "start": 82.76,
    "end": 84.16,
    "text": "哪怕大盘震荡也得泰山崩于"
  },
  {
    "start": 84.16,
    "end": 84.96,
    "text": "前而色不变"
  },
  {
    "start": 84.96,
    "end": 85.56,
    "text": "一旦破位"
  },
  {
    "start": 85.56,
    "end": 86.48,
    "text": "哪怕只转两个点"
  },
  {
    "start": 86.48,
    "end": 87.52,
    "text": "甚至在成本线下"
  },
  {
    "start": 87.52,
    "end": 88.56,
    "text": "也必须坚决斩仓"
  },
  {
    "start": 90.62,
    "end": 91.22,
    "text": "我明白了"
  },
  {
    "start": 91.22,
    "end": 91.98,
    "text": "执行合一"
  },
  {
    "start": 91.98,
    "end": 92.9,
    "text": "不可执念死客"
  },
  {
    "start": 92.9,
    "end": 94.06,
    "text": "不可贪婪死客"
  },
  {
    "start": 94.06,
    "end": 95.1,
    "text": "一切交由交易系统"
  },
  {
    "start": 95.1,
    "end": 96.3,
    "text": "和严格的风险控制"
  },
  {
    "start": 96.5,
    "end": 97.02,
    "text": "行了"
  },
  {
    "start": 97.82,
    "end": 99.02,
    "text": "今晚不用复盘了"
  },
  {
    "start": 99.74,
    "end": 100.54,
    "text": "去洗把脸"
  },
  {
    "start": 101.02,
    "end": 102.5,
    "text": "把脑里的水倒干净"
  },
  {
    "start": 103.26,
    "end": 104.18,
    "text": "明天开盘"
  },
  {
    "start": 104.58,
    "end": 106.38,
    "text": "我们重新认识一下市长"
  }
]