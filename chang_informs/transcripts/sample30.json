[
  {
    "start": 0.0,
    "end": 1.8,
    "text": "善哥 我刚才全出了这一单"
  },
  {
    "start": 1.8,
    "end": 2.96,
    "text": "赚了二十多个点"
  },
  {
    "start": 2.96,
    "end": 4.56,
    "text": "但我现在不属于心里全是汉"
  },
  {
    "start": 4.56,
    "end": 5.84,
    "text": "心跳得跟打鼓一样"
  },
  {
    "start": 5.84,
    "end": 6.76,
    "text": "我真拿不住了"
  },
  {
    "start": 6.76,
    "end": 8.48,
    "text": "二十个点落派为安"
  },
  {
    "start": 8.48,
    "end": 10.32,
    "text": "能保住本金和利润"
  },
  {
    "start": 10.32,
    "end": 11.52,
    "text": "没什么不好"
  },
  {
    "start": 11.52,
    "end": 12.48,
    "text": "可是我不明白"
  },
  {
    "start": 12.48,
    "end": 13.12,
    "text": "为什么"
  },
  {
    "start": 13.12,
    "end": 14.16,
    "text": "为什么魁二十眼的时候"
  },
  {
    "start": 14.16,
    "end": 15.16,
    "text": "我能像个木头坐在里面"
  },
  {
    "start": 15.16,
    "end": 16.0,
    "text": "眼皮都不眨一下"
  },
  {
    "start": 16.0,
    "end": 16.56,
    "text": "因为我越觉得"
  },
  {
    "start": 16.56,
    "end": 17.84,
    "text": "他会反弹丝丝捏着梦"
  },
  {
    "start": 17.84,
    "end": 19.04,
    "text": "而现在赚了二十个点"
  },
  {
    "start": 19.04,
    "end": 19.56,
    "text": "稍微一会儿"
  },
  {
    "start": 19.56,
    "end": 20.4,
    "text": "我就吓得赶紧跑"
  },
  {
    "start": 20.4,
    "end": 21.48,
    "text": "我到底是怎么了"
  },
  {
    "start": 21.48,
    "end": 22.56,
    "text": "因为魁损的时候"
  },
  {
    "start": 22.56,
    "end": 24.32,
    "text": "你在和自己的执念死了"
  },
  {
    "start": 24.32,
    "end": 25.24,
    "text": "而盈利的时候"
  },
  {
    "start": 25.24,
    "end": 26.64,
    "text": "你在和贪婪死了"
  },
  {
    "start": 26.64,
    "end": 27.64,
    "text": "规规的你"
  },
  {
    "start": 27.64,
    "end": 29.6,
    "text": "是你的认知在被世上牵着走的"
  }
]